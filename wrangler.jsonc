{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-wrapped",
  "account_id": "52149a64c8a2dba44cd8a64f81e8ee6a",
  "main": "worker/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/og/*", "/og.png"]
  },
  "kv_namespaces": [{ "binding": "CACHE", "id": "71539940ed6f4c51a925ef76099095d4" }],
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "4401", "simple": { "limit": 12, "period": 60 } }],
  "analytics_engine_datasets": [{ "binding": "WRAPS", "dataset": "github_wrapped" }],
  "observability": { "enabled": true }
}
